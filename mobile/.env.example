# Authentik API base URL. For a device on your LAN use your computer's IP, e.g. http://192.168.1.20:8080
EXPO_PUBLIC_API_URL=http://localhost:8080

# "firebase" (default) or "dev". Dev mode signs in locally and sends `dev:<uid>` tokens;
# it only works against a backend running with AUTH_MODE=dev.
EXPO_PUBLIC_AUTH_MODE=dev

# Firebase web config (public identifiers, not secrets — access is controlled by Auth and the API).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
