# Used by docker-compose. Copy to .env and replace.
SANDBOX_WORKER_SECRET=change-me-to-a-random-string-of-32-chars

# Public tunnel (docker compose --profile tunnel). Free ngrok account, no card:
# dashboard.ngrok.com → Your Authtoken, and Domains (every free account has one static domain).
NGROK_AUTHTOKEN=
NGROK_DOMAIN=your-name.ngrok-free.app
