# Must match the API's SANDBOX_WORKER_SECRET.
WORKER_SECRET=change-me-to-a-random-string-of-32-chars
PORT=8090
HOST=127.0.0.1
MAX_SESSIONS=4
MAX_SESSION_SECONDS=900
# Keep true. Only set false for local debugging on a host that cannot run Chromium's sandbox;
# production refuses to start with it disabled.
CHROMIUM_SANDBOX=true
LOG_LEVEL=info
