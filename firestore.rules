rules_version = '2';

// Clients never read or write Firestore directly. Every access goes through the
// Authentik API, which verifies the Firebase ID token and enforces ownership.
// The API uses the Admin SDK, which bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
