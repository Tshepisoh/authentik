# ── Local development (no Firebase needed) ───────────────────────────────
NODE_ENV=development
PORT=8080
AUTH_MODE=dev          # accepts "Bearer dev:<uid>" — refused when NODE_ENV=production
STORAGE=memory         # in-process store — refused when NODE_ENV=production
LOG_LEVEL=info

# ── Production ───────────────────────────────────────────────────────────
# NODE_ENV=production
# AUTH_MODE=firebase
# STORAGE=firestore
# FIREBASE_PROJECT_ID=your-project-id
# Credentials come from the runtime service account or GOOGLE_APPLICATION_CREDENTIALS.
# Never commit a service-account JSON to this repository.
# AUDIT_SALT=<random 32+ chars>
# TRUST_PROXY_HOPS=1
# CORS_ORIGINS=          # only needed for browser clients

# ── Threat reputation ────────────────────────────────────────────────────
# Without a key, every scan reports reputation as unavailable and the verdict is
# "inconclusive" unless other warnings are found. That is deliberate.
# Safe Browsing is free (no billing account) and limited to non-commercial use.
GOOGLE_SAFE_BROWSING_API_KEY=
# BLOCKLIST_PATH=./data/blocklist.txt
# Optional free domain feeds, no key needed, comma-separated. Check each feed's licence first.
# THREAT_FEED_URLS=https://urlhaus.abuse.ch/downloads/hostfile/,https://openphish.com/feed.txt
# THREAT_FEED_REFRESH_MINUTES=60
# Known-bad domains sent to phones, and how long phones trust their copy.
# THREAT_LIST_MAX_ENTRIES=50000
# THREAT_LIST_MAX_AGE_SECONDS=259200
RDAP_ENABLED=true

# ── Reports ──────────────────────────────────────────────────────────────
REPORT_RETENTION_DAYS_DEFAULT=30
REPORT_RETENTION_DAYS_MIN=1
REPORT_RETENTION_DAYS_MAX=90

# ── Sandbox (fails closed when unset) ────────────────────────────────────
SANDBOX_WORKER_URL=http://127.0.0.1:8090
SANDBOX_WORKER_SECRET=change-me-to-a-random-string-of-32-chars
SANDBOX_SESSION_TTL_SECONDS=600
SANDBOX_IDLE_TIMEOUT_SECONDS=120
SANDBOX_MAX_SESSIONS_PER_USER=1
